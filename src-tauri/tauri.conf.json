{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "取色鸭",
  "version": "2.0.7",
  "identifier": "com.lynnwang.duckcolorpicker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "取色鸭",
        "width": 420,
        "height": 728,
        "minWidth": 420,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "copyright": "Copyright © 2026 Duck Color Picker",
    "category": "Utility",
    "shortDescription": "跨平台中文屏幕取色器",
    "longDescription": "取色鸭（Duck Color Picker）是一款适用于 Windows 和 macOS 的中文屏幕取色器。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  }
}
